{
  "description": "With --toolchains, a setup step puts the installed toolchain on PATH, a step with no version says why it does nothing, and a missing toolchain is named.",
  "args": [
    "run",
    "--toolchains",
    "../0029-toolchains",
    "--json",
    "-q"
  ],
  "expect": {
    "failed": 0,
    "legs": [
      {
        "key": "build",
        "result": "success",
        "steps": [
          {
            "outcome": "success",
            "reason": "~toolchain: Node.js 20.11.1 from ../0029-toolchains"
          },
          {
            "outcome": "success",
            "reason": "~the runner's SDK is used"
          },
          {
            "outcome": "success"
          }
        ]
      },
      {
        "key": "missing",
        "result": "success",
        "steps": [
          {
            "outcome": "skipped",
            "reason": "~Node.js 22.0.0 is not in ../0029-toolchains (run `localci setup`)"
          },
          {
            "outcome": "success"
          }
        ]
      }
    ]
  },
  "hosts": [
    "linux",
    "macos"
  ]
}
