{
  "description": "--affected runs a tool step when a file that an earlier step sources changed, also when that earlier step runs unknown commands (found in a local review, 2026-10-10).",
  "args": [
    "run",
    "--affected",
    "--base",
    "base",
    "--json",
    "-q"
  ],
  "expect": {
    "failed": 0,
    "legs": [
      {
        "steps": [
          {
            "outcome": "success"
          },
          {
            "outcome": "success"
          },
          {
            "outcome": "success"
          }
        ]
      }
    ]
  },
  "hosts": [
    "linux",
    "macos"
  ],
  "requires": [
    "python3"
  ]
}
