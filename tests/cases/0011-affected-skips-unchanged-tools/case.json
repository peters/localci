{
  "description": "--affected leaves out tool steps whose inputs did not change (Rust, and a script that only runs cargo), and runs steps for changed inputs (Node) and unknown commands. See ADR-0009.",
  "args": [
    "run",
    "--affected",
    "--base",
    "base",
    "--json",
    "-q"
  ],
  "expect": {
    "failed": 0,
    "legs": [
      {
        "result": "success",
        "steps": [
          {
            "outcome": "success"
          },
          {
            "outcome": "skipped",
            "reason": "~affected: no Rust inputs changed"
          },
          {
            "outcome": "success"
          },
          {
            "outcome": "skipped",
            "reason": "~affected: no Rust inputs changed"
          },
          {
            "outcome": "success"
          }
        ]
      }
    ]
  },
  "hosts": [
    "linux",
    "macos"
  ],
  "requires": [
    "python3"
  ]
}
